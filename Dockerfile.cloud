# Cloud-connected UI: no direct model or source-data access is required.
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pip install --no-cache-dir "boto3==1.43.124"
RUN useradd --uid 10001 --create-home costlens && mkdir /data && chown costlens:costlens /data
WORKDIR /app
COPY costlens ./costlens
USER costlens
VOLUME /data
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=4)"]
CMD ["python", "-m", "costlens", "serve", "--host", "0.0.0.0", "--db", "/data/costlens-demo.sqlite", "--port", "8765"]
